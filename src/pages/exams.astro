---
import Base from '../layouts/Base.astro';
import { exams, subjectByCode } from '../data/courses';
---
<Base title="Exam schedule">
  <p class="crumb"><a href="/">Home</a> / Exams</p>
  <h1>Semester final exam</h1>
  <div class="scroll">
    <table>
      <thead><tr><th>Date</th><th>Subjects</th></tr></thead>
      <tbody>
        {exams.map((e) => (
          <tr>
            <td>{e.date}</td>
            <td>{e.codes.map((c) => <div><a href={`/subject/${c}`}>{c}</a> — {subjectByCode(c)?.title}</div>)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">Dates are copied exactly as printed in the routine. It prints the year as 2026 although this trimester starts in November 2026, so confirm the year on the official notice.</p>
</Base>
